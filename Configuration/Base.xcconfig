// Base.xcconfig - Shared settings for all Shell builds

// Development Team
DEVELOPMENT_TEAM = 72KB9YQR7B

// Swift Settings
SWIFT_VERSION = 5.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

// Deployment Targets
// 26.0 on every platform, including Catalyst (which derives its macOS version
// from IPHONEOS_DEPLOYMENT_TARGET): the Catalyst menu bar is owned by SwiftUI
// Commands on macOS 26+, and the sources call 26-only API un-gated now that the
// pre-26 `#available` rail is gone. Lowering this floor will not compile.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
XROS_DEPLOYMENT_TARGET = 26.0

// Supported Platforms (includes Catalyst)
SUPPORTED_PLATFORMS = iphoneos iphonesimulator xros xrsimulator
SUPPORTS_MACCATALYST = YES
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

// Device Families (1=iPhone, 2=iPad, 7=Apple Vision)
TARGETED_DEVICE_FAMILY = 1,2,7

// App Identity
PRODUCT_NAME = Shell
PRODUCT_BUNDLE_IDENTIFIER = dev.chr33s.shell
INFOPLIST_FILE = shell/Info.plist

// Fork-specific Apple configuration (see spec section 8).
SHELL_KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)dev.chr33s.shell
SHELL_CLOUDKIT_CONTAINER = iCloud.dev.chr33s.shell

// Runtime configuration the phone and Watch read back from Info.plist.
// The placeholder is recognised as "no broker configured". A real host is
// supplied by Configuration/Local.xcconfig (untracked) or by the Xcode Cloud
// SHELL_CONTROL_BROKER_URL environment variable. The `$()` splits `//`, which
// xcconfig would otherwise treat as a comment.
SHELL_CONTROL_BROKER_URL = https:/$()/control.invalid

// Entitlements
CODE_SIGN_ENTITLEMENTS = shell/Entitlements/Shell.entitlements
CODE_SIGN_STYLE = Automatic

// Swift Bridging Header
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/shell/shell-Bridging-Header.h

// Security Settings
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
RUNTIME_EXCEPTION_ALLOW_UNSIGNED_EXECUTABLE_MEMORY = NO
RUNTIME_EXCEPTION_DISABLE_LIBRARY_VALIDATION = NO

// Asset catalog
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES

// Info.plist generation
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Shell
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
INFOPLIST_KEY_NSFaceIDUsageDescription = Authenticate to use SSH keys protected by the Secure Enclave or Keychain.
INFOPLIST_KEY_NSCameraUsageDescription = Scan a pairing QR from npx @chr33s/shell to connect this device to your Mac broker.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// Versioning
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0

// Localization
SWIFT_EMIT_LOC_STRINGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES

// Misc
CLANG_ENABLE_MODULES = YES
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// Link libresolv for DNS lookups used by the networking helpers.
//
// GhosttyKit statically links its own oniguruma; keep it unexported so nothing
// built with -undefined dynamic_lookup can flat-lookup into it.
OTHER_LDFLAGS = $(inherited) -lresolv -Wl,-unexported_symbol,_onig* -Wl,-unexported_symbol,_Onig*

// ios_system resource plists are not needed on Mac Catalyst.
EXCLUDED_SOURCE_FILE_NAMES[sdk=macosx*] = $(inherited) commandDictionary.plist extraCommandsDictionary.plist

// GhosttyKit and the ios_system frameworks ship arm64-only simulator slices,
// so an x86_64 simulator build has nothing to link against.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = $(inherited) x86_64
EXCLUDED_ARCHS[sdk=xrsimulator*] = $(inherited) x86_64

// An untracked local override, if the developer or Xcode Cloud has one.
#include? "Local.xcconfig"
