{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shell.chr33s.dev/schemas/input-spec.schema.json",
  "title": "input.request",
  "description": "An immutable typed question (docs/specs/agent-relay.md section 6). Byte limits (prompt 2048, label 256, description 1024, spec 16 KiB) are UTF-8 and checked by implementations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "request_id",
    "origin_id",
    "job_id",
    "run_id",
    "created_at",
    "expires_at",
    "summary",
    "effect",
    "source",
    "questions",
    "allowed_responses",
    "minimum_review",
    "required_features"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "input.request"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "origin_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "type": "string",
      "description": "answer_question; any other value is not remotely answerable"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "provider_build",
        "adapter_build",
        "native_request_sha256",
        "context_sha256",
        "answer_mapping_sha256",
        "agent_session_id",
        "native_wait_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "provider_build": {
          "type": "string"
        },
        "adapter_build": {
          "type": "string"
        },
        "native_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "answer_mapping_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "agent_session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_wait_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "connection_epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "provider_session_id": {
          "type": "string"
        },
        "provider_turn_id": {
          "type": "string"
        },
        "provider_request_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "integer"
            }
          ]
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "kind",
              "required",
              "choices"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "single_choice"
              },
              "required": {
                "type": "boolean"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "kind",
              "required",
              "choices",
              "min_selections",
              "max_selections"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "multi_choice"
              },
              "required": {
                "type": "boolean"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "min_selections": {
                "type": "integer",
                "minimum": 0
              },
              "max_selections": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "kind",
              "required",
              "max_bytes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "text"
              },
              "required": {
                "type": "boolean"
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "hint": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "allowed_responses": {
      "type": "array",
      "items": {
        "enum": [
          "answer",
          "decline"
        ]
      },
      "contains": {
        "const": "answer"
      },
      "uniqueItems": true
    },
    "minimum_review": {
      "enum": [
        "watch",
        "full"
      ]
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
