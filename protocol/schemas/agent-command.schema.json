{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shell.chr33s.dev/schemas/agent-command.schema.json",
  "title": "shell-agent/1 signed commands",
  "description": "Signed JWS payloads of the agent command union (docs/specs/agent-relay.md sections 7.1 and 15). action_digest is sha256 over the JCS encoding of {type, agent_session_id, run_id, expected_session_version, mode, expected_turn_id?, text} or {type, agent_session_id, run_id, expected_session_version, turn_id}.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "command_id",
        "device_id",
        "aud",
        "issued_at",
        "not_after",
        "request_id",
        "request_hash",
        "expected_state_version",
        "policy_version",
        "challenge_id",
        "action"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "input.respond"
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "aud": {
          "type": "string",
          "pattern": "^shell-control:"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "not_after": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "expected_state_version": {
          "type": "integer"
        },
        "policy_version": {
          "type": "integer"
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "enum": [
            "answer",
            "decline"
          ]
        },
        "answers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question_id",
                  "kind",
                  "choice_id"
                ],
                "properties": {
                  "question_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  },
                  "kind": {
                    "const": "single_choice"
                  },
                  "choice_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question_id",
                  "kind",
                  "choice_ids"
                ],
                "properties": {
                  "question_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  },
                  "kind": {
                    "const": "multi_choice"
                  },
                  "choice_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                    },
                    "uniqueItems": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question_id",
                  "kind",
                  "text"
                ],
                "properties": {
                  "question_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  },
                  "kind": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "answer"
          }
        }
      },
      "then": {
        "required": [
          "answers"
        ]
      },
      "else": {
        "not": {
          "required": [
            "answers"
          ]
        }
      },
      "title": "input.respond"
    },
    {
      "title": "agent.message",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "command_id",
        "device_id",
        "aud",
        "issued_at",
        "not_after",
        "challenge_id",
        "agent_session_id",
        "run_id",
        "expected_session_version",
        "action_digest",
        "mode",
        "text"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "aud": {
          "type": "string",
          "pattern": "^shell-control:"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "not_after": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agent_session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_session_version": {
          "type": "integer"
        },
        "action_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "type": {
          "const": "agent.message"
        },
        "mode": {
          "enum": [
            "new_turn",
            "steer"
          ]
        },
        "expected_turn_id": {
          "type": "string",
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "title": "agent.turn.cancel",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "command_id",
        "device_id",
        "aud",
        "issued_at",
        "not_after",
        "challenge_id",
        "agent_session_id",
        "run_id",
        "expected_session_version",
        "action_digest",
        "turn_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "aud": {
          "type": "string",
          "pattern": "^shell-control:"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "not_after": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agent_session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_session_version": {
          "type": "integer"
        },
        "action_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "type": {
          "const": "agent.turn.cancel"
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  ]
}
