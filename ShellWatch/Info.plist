<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Runtime configuration the app reads back at launch. Xcode merges the
	     generated Info.plist keys into this file, so only the settings that
	     have no INFOPLIST_KEY_ equivalent live here. -->
	<!-- Shell Watch ships inside the iPhone app's bundle but runs
	     independently of it: it enrols and operates with the phone app absent
	     (spec.watch.md section 1). Embedding is a distribution choice — one App
	     Store record, one archive — and the independence the spec requires is
	     WKRunsIndependentlyOfCompanionApp, not a separate bundle. -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>dev.chr33s.shell</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
	<key>SHELLControlBrokerURL</key>
	<string>$(SHELL_CONTROL_BROKER_URL)</string>
	<key>SHELLWatchKeychainAccessGroup</key>
	<string>$(SHELL_WATCH_KEYCHAIN_ACCESS_GROUP)</string>
</dict>
</plist>
