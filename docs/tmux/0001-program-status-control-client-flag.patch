+.Ic refresh\-client
+.Fl r ;
+replies to later queries from the same pane wait for it
 .It Cm pause\-after Ns = Ns Ar seconds
 output is paused once the pane is
 .Ar seconds
@@ -1561,7 +1566,10 @@ sets a comma-separated list of client flags, see
 .Ic attach\-session .
 .Fl r
 allows a control mode client to provide information about a pane via a report
-(such as the response to OSC 10).
+(such as the response to OSC 10, or to an OSC 7501 support query for a client
+with the
+.Cm program\-status
+flag).
 The argument is a pane ID (with a leading
 .Ql % ) ,
 a colon, then a report escape sequence.
diff --git a/tmux.h b/tmux.h
index f95f96f..e92b34c 100644
--- a/tmux.h
+++ b/tmux.h
@@ -1254,6 +1254,7 @@ struct window_mode_entry {
 enum input_request_type {
 	INPUT_REQUEST_PALETTE,
 	INPUT_REQUEST_CLIPBOARD,
