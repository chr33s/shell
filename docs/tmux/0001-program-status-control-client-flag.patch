--- a/cmd-refresh-client.c
+++ b/cmd-refresh-client.c
@@ -138,8 +138,9 @@ out:
 }
 
 static void
-cmd_refresh_report(struct tty *tty, const char *value)
+cmd_refresh_report(struct client *tc, const char *value)
 {
+	struct tty		*tty = &tc->tty;
 	struct window_pane	*wp;
 	u_int			 pane;
 	int			 fg, bg;
@@ -159,6 +160,11 @@ cmd_refresh_report(struct tty *tty, const char *value)
 	if (wp == NULL)
 		goto out;
 
+	if (strncmp(split, "\033]7501;", 7) == 0) {
+		input_request_program_status_reply(tc, wp);
+		goto out;
+	}
+
 	fg = wp->control_fg;
 	bg = wp->control_bg;
 	if (tty_keys_colours(tty, split, strlen(split), &size, &fg, &bg) == 0) {
@@ -244,7 +250,7 @@ cmd_refresh_client_exec(struct cmd *self, struct cmdq_item *item)
 	if (args_has(args, 'f'))
 		server_client_set_flags(tc, args_get(args, 'f'));
 	if (args_has(args, 'r'))
-		cmd_refresh_report(tty, args_get(args, 'r'));
+		cmd_refresh_report(tc, args_get(args, 'r'));
 
 	if (args_has(args, 'A')) {
 		if (~tc->flags & CLIENT_CONTROL)
diff --git a/input.c b/input.c
index 2732b61..c1b5da4 100644
--- a/input.c
+++ b/input.c
@@ -173,6 +173,7 @@ static void	input_osc_110(struct input_ctx *, const char *);
 static void	input_osc_111(struct input_ctx *, const char *);
 static void	input_osc_112(struct input_ctx *, const char *);
 static void	input_osc_133(struct input_ctx *, const char *);
+static void	input_osc_7501(struct input_ctx *, const char *);
 
 /* Transition entry/exit handlers. */
 static void	input_clear(struct input_ctx *);
@@ -2770,6 +2771,9 @@ input_exit_osc(struct input_ctx *ictx)
 	case 133:
 		input_osc_133(ictx, p);
 		break;
+	case 7501:
+		input_osc_7501(ictx, p);
+		break;
 	default:
 		log_debug("%s: unknown '%u'", __func__, option);
 		break;
@@ -3259,6 +3263,19 @@ input_fire_command_event(struct window_pane *wp, const char *name)
 	events_fire(name, ep);
 }
 
+/*
+ * Handle the OSC 7501 (program status) sequence. tmux does not present
+ * program status itself; reports pass through to control clients in %output.
+ * A support query is held as a request for a control client that asked to
+ * answer it, so replies to later queries (such as DA) stay behind it.
+ */
+static void
+input_osc_7501(struct input_ctx *ictx, const char *p)
+{
+	if (strcmp(p, "?") == 0)
+		input_add_request(ictx, INPUT_REQUEST_PROGRAM_STATUS, 0);
+}
+
 /* Handle the OSC 133 sequence. */
 static void
 input_osc_133(struct input_ctx *ictx, const char *p)
@@ -3590,7 +3607,15 @@ input_add_request(struct input_ctx *ictx, enum input_request_type type, int idx)
 			continue;
 		if (loop->session == NULL || !session_has(loop->session, w))
 			continue;
-		if (~loop->tty.flags & TTY_STARTED)
+		if (type == INPUT_REQUEST_PROGRAM_STATUS) {
+			/*
+			 * Only a control client that asked for it answers: it
+			 * sees the query in %output and replies with
+			 * refresh-client -r.
+			 */
+			if (~loop->flags & CLIENT_CONTROL_PROGRAMSTATUS)
+				continue;
+		} else if (~loop->tty.flags & TTY_STARTED)
 			continue;
 		if (c == NULL)
 			c = loop;
@@ -3614,6 +3639,7 @@ input_add_request(struct input_ctx *ictx, enum input_request_type type, int idx)
 	case INPUT_REQUEST_CLIPBOARD:
 		tty_putcode_ss(&c->tty, TTYC_MS, "", "?");
 		break;
+	case INPUT_REQUEST_PROGRAM_STATUS:
 	case INPUT_REQUEST_QUEUE:
 		break;
 	}
@@ -3700,6 +3726,44 @@ input_request_reply(struct client *c, enum input_request_type type, void *data)
 	}
 }
 
+/*
+ * Handle a control client's program status (OSC 7501) support reply for a
+ * pane: answer the oldest request from that pane, then release the replies
+ * queued behind it, in order.
+ */
+void
+input_request_program_status_reply(struct client *c, struct window_pane *wp)
+{
+	struct input_request	*ir, *ir1, *found = NULL;
+	int			 complete = 0;
+
+	TAILQ_FOREACH(ir, &c->input_requests, centry) {
+		if (ir->type == INPUT_REQUEST_PROGRAM_STATUS &&
+		    ir->ictx->wp == wp) {
+			found = ir;
+			break;
+		}
+	}
+	if (found == NULL)
+		return;
+
+	TAILQ_FOREACH_SAFE(ir, &found->ictx->requests, entry, ir1) {
+		if (complete && ir->type != INPUT_REQUEST_QUEUE)
+			break;
+		if (ir->type == INPUT_REQUEST_QUEUE)
+			input_send_reply(ir->ictx, ir->data);
+		else if (ir == found) {
+			/* The reply repeats the query, terminator included. */
+			if (ir->end == INPUT_END_BEL)
+				input_send_reply(ir->ictx, "\033]7501;?\007");
+			else
+				input_send_reply(ir->ictx, "\033]7501;?\033\\");
+			complete = 1;
+		}
+		input_free_request(ir);
+	}
+}
+
 /* Cancel pending requests for client. */
 void
 input_cancel_requests(struct client *c)
diff --git a/server-client.c b/server-client.c
index 2659a66..392d3f4 100644
--- a/server-client.c
+++ b/server-client.c
@@ -2992,6 +2992,8 @@ server_client_control_flags(struct client *c, const char *next)
 		return (CLIENT_CONTROL_WAITEXIT);
 	if (strcmp(next, "new-layouts") == 0)
 		return (CLIENT_CONTROL_NEWLAYOUTS);
+	if (strcmp(next, "program-status") == 0)
+		return (CLIENT_CONTROL_PROGRAMSTATUS);
 	return (0);
 }
 
@@ -3060,6 +3062,8 @@ server_client_get_flags(struct client *c)
 		strlcat(s, "wait-exit,", sizeof s);
 	if (c->flags & CLIENT_CONTROL_NEWLAYOUTS)
 		strlcat(s, "new-layouts,", sizeof s);
+	if (c->flags & CLIENT_CONTROL_PROGRAMSTATUS)
+		strlcat(s, "program-status,", sizeof s);
 	if (c->flags & CLIENT_CONTROL_PAUSEAFTER) {
 		xsnprintf(tmp, sizeof tmp, "pause-after=%u,",
 		    c->pause_age / 1000);
