# External Swift packages vendored under vendor/ — managed by scripts/vendor.py.
#
#   DIR   directory under vendor/; must equal the upstream repository name so the
#         SwiftPM package identity is unchanged (product references use it)
#   URL   upstream git repository
#   REF   pinned tag or commit
#   options
#     binaries=A,B   binaryTarget names to keep; SwiftPM fetches each zip and
#                    verifies the upstream SHA-256 (unlisted ones are removed)
#     drop=X,Y       package identities to strip, together with the targets
#                    that use them (things this project never builds)
#     source=none    binary-only package: prune its uncompiled source tree,
#                    keeping manifests, top-level license/README files and
#                    license files at any depth
#     keep=A,B       with source=none, further top-level entries to keep
#
# Bump a pin with `./scripts/vendor.py update DIR REF`; `status` lists newer tags.

# DIR                            URL                                                         REF        options
ios_system-rootshell             https://github.com/kitknox/ios_system-rootshell.git         v0.1.1     binaries=ios_system,awk,files,shell,text source=none
libarchive_ios-rootshell         https://github.com/kitknox/libarchive_ios-rootshell.git     v0.1.0     binaries=libarchive_ios source=none
vim-rootshell                    https://github.com/kitknox/vim-rootshell.git                v0.1.0     binaries=vim,xxd source=none keep=VimRuntime.bundle
